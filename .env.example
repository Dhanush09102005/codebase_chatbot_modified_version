# ==============================================================================
# LLM Configuration
# ==============================================================================

# LLM Provider: "huggingface", "groq", "openai", "ollama"
LLM_PROVIDER=huggingface

# Model name (provider-specific)
# HuggingFace: meta-llama/Llama-3.1-8B-Instruct
# Groq: llama-3.1-8b-instant
# OpenAI: gpt-4-turbo-preview
# Ollama: llama3.1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Maximum tokens for LLM generation
LLM_MAX_TOKENS=512

# Sampling temperature (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# Device for local LLM inference
LLM_DEVICE=cpu

# ==============================================================================
# API Keys
# ==============================================================================

# HuggingFace Configuration
HF_TOKEN=
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# Groq API key (for Groq LLM inference)
GROQ_API_KEY=

# OpenAI API key (for GPT models)
OPENAI_API_KEY=

# Ollama base URL (for local Ollama deployment)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# Prompt Builder Configuration
# ==============================================================================

# Include line numbers in code chunks
PROMPT_INCLUDE_LINE_NUMBERS=true

# Include chunk types (function, class, etc.)
PROMPT_INCLUDE_CHUNK_TYPES=true

# Maximum code chunks to include in prompt
PROMPT_MAX_CHUNKS=5

# Instruction style: "strict" (answer only from context) or "flexible"
PROMPT_INSTRUCTION_STYLE=strict

# ==============================================================================
# Embedding Configuration
# ==============================================================================

# Embedding Model (lighter, open-source)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Repository Management
REPO_STORAGE_PATH=./data/repos
GITHUB_TOKEN=  # Optional: Personal Access Token for private repo access
GIT_HASH_ALGORITHM=sha256  # Hash algorithm for repo identifiers

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs
LOG_MAX_BYTES=10485760  # 10MB per log file
LOG_BACKUP_COUNT=5      # Keep 5 backup files

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
HYBRID_ALPHA=0.5  # 0=pure BM25, 1=pure vector, 0.5=balanced

# Retrieval Configuration
RETRIEVAL_TOP_K=10  # Initial candidates
RERANK_TOP_K=5      # Final results after reranking
MIN_SIMILARITY_SCORE=0.3  # Minimum score threshold
ENABLE_METADATA_FILTERING=true
ENABLE_RERANKING=true

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=cpu  # or "cuda" for GPU


CHROMA_COLLECTION_NAME=code_chunks
CHROMA_DISTANCE_METRIC=cosine  # cosine, l2, or ip
